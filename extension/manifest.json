{
  "manifest_version": 3,
  "name": "eisenberg",
  "version": "0.3.0",
  "permissions": ["sidePanel", "storage", "tabs", "debugger"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "eisenberg"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html"
}
