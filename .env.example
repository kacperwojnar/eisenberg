# Local stand-in. Replace with the Neon connection string when you connect it.
DATABASE_URL=postgresql://eisenberg:eisenberg@localhost:5432/eisenberg

# Local RabbitMQ from infra/docker-compose.yml.
# Inside the api and worker containers this host is "rabbitmq", not localhost.
RABBITMQ_URL=amqp://eisenberg:eisenberg@localhost:5672

# Empty means the API stores uploaded bytes under data/files.
BLOB_CONNECTION_STRING=

FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_CHAT_DEPLOYMENT=claude-haiku-5-5
FOUNDRY_EMBEDDING_DEPLOYMENT=

CONTENT_UNDERSTANDING_ENDPOINT=
CONTENT_UNDERSTANDING_API_KEY=

QDRANT_URL=
QDRANT_API_KEY=

ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=

# Development switch only. Ignored once both Entra values are set.
DEVELOPMENT_AUTH=true
