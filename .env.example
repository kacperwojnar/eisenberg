# Optional. Docker Compose can load this file. The .NET projects do not.
# Local dotnet run uses appsettings.Development.json.
# Inside the api and worker containers, Compose sets DATABASE_URL and RABBITMQ_URL itself.

# Empty means the API stores uploaded bytes under data/files.
BLOB_CONNECTION_STRING=

FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_CHAT_DEPLOYMENT=claude-haiku-5-5
FOUNDRY_EMBEDDING_DEPLOYMENT=

CONTENT_UNDERSTANDING_ENDPOINT=
CONTENT_UNDERSTANDING_API_KEY=

QDRANT_URL=
QDRANT_API_KEY=

ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=

# Development switch only. Ignored once both Entra values are set.
DEVELOPMENT_AUTH=true
