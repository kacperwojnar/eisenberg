# Optional. Docker Compose can load this file. The .NET projects do not.
# Local dotnet run uses appsettings.Development.json.
# Inside the api and worker containers, the local Compose file sets DATABASE_URL and RABBITMQ_URL itself.
# The production Compose file does not. It reads those two from this file and turns development login off.

# Address of the API as the website container reaches it. Local Compose sets http://api:5000.
API_BASE_URL=http://localhost:5000
# Address of the API as a browser and the extension reach it.
PUBLIC_API_URL=http://localhost:5000
# Public address of the website. The API allows this origin in addition to localhost and the extension.
WEB_ORIGIN=http://localhost:3000

# Empty means the API stores uploaded bytes under data/files.
BLOB_CONNECTION_STRING=

FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_CHAT_DEPLOYMENT=claude-haiku-5-5
FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-large

CONTENT_UNDERSTANDING_ENDPOINT=
CONTENT_UNDERSTANDING_API_KEY=

QDRANT_URL=
QDRANT_API_KEY=

# Form interpretation. Empty values mark a run as not connected.
# Remote MCP endpoint of the Playwright workspace and a workspace access token.
PLAYWRIGHT_MCP_URL=
PLAYWRIGHT_MCP_API_KEY=
# Model that clicks and looks at screenshots. Empty uses claude-haiku-5-5.
FOUNDRY_AGENT_DEPLOYMENT=
# Model that builds the form model. Empty uses claude-sonnet-5-5.
FOUNDRY_MODEL_DEPLOYMENT=claude-sonnet-5-5
# Budget of one run. Empty uses 400 actions, 60 minutes, and 60 options.
INTERPRETATION_MAX_ACTIONS=400
INTERPRETATION_MAX_MINUTES=60
INTERPRETATION_MAX_SWEEP_OPTIONS=60

ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=

# Development switch only. Ignored once both Entra values are set.
DEVELOPMENT_AUTH=true
